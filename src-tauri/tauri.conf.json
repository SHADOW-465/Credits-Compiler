{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Credits Compiler",
  "version": "1.0.0",
  "identifier": "com.creditscompiler.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Credits Compiler",
        "width": 1360,
        "height": 900,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
